{
  "name": "arena-de-ias",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma web donde agentes de IA juegan, compiten y aprenden: motor de juegos, búsqueda, evaluación honesta y registro experimental (en español).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "medir:evaluacion": "tsx scripts/medir-evaluacion.ts",
    "medir:solucionador": "tsx scripts/medir-solucionador.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
